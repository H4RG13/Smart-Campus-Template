# Per-school configuration. Copy to deploy/.env and fill in real values.
# Never commit the real .env for a school deployment.

# --- Database ---
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=changeme

# --- Branding (bound to SmartCampus.Configuration.BrandingSettings) ---
BRANDING__SCHOOLNAME=SmartCampus Demo School
BRANDING__LOGOURL=/branding/logo.png
BRANDING__PRIMARYCOLOR=#1D4ED8
BRANDING__SECONDARYCOLOR=#0F172A
BRANDING__TIMEZONE=UTC

# --- School rules (bound to SmartCampus.Configuration.SchoolSettings) ---
SCHOOL__ATTENDANCELATETHRESHOLDMINUTES=10
SCHOOL__DEFAULTTIMEZONE=UTC
SCHOOL__SCHOOLDAYSTARTTIME=08:00

# --- IoT (bound to SmartCampus.Configuration.IotSettings) ---
IOT__HEARTBEATINTERVALSECONDS=60
IOT__OFFLINETHRESHOLDMULTIPLIER=3

# --- Security (generate real values per school, never reuse across clients) ---
JWT_SIGNING_KEY=replace-with-a-real-256-bit-secret
JWT__ISSUER=SmartCampus.Api
JWT__AUDIENCE=SmartCampus.Client
JWT__EXPIRYMINUTES=480

# --- Seed admin account (bound to SmartCampus.Configuration.SeedSettings) ---
# Change the password immediately after first login in a real deployment.
SEED__ADMINEMAIL=admin@example.com
SEED__ADMINPASSWORD=replace-with-a-real-password

# --- SMTP (Notifications module) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Domain / SSL ---
DOMAIN_NAME=school.example.com
CERTBOT_EMAIL=admin@example.com
