      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smartcampus;Username=smartcampus;Password=changeme"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
